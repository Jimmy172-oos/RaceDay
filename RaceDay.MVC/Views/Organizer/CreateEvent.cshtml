@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-body p-5">
                <h3 class="fw-bold mb-4">Create New Event</h3>
                
                <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Event Name</label>
                        <input type="text" name="eventName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="description" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Date</label>
                            <input type="date" name="eventDate" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Location</label>
                            <input type="text" name="location" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Distance</label>
                            <input type="text" name="distance" class="form-control" placeholder="e.g. 42.2km" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Event Type</label>
                            <select name="eventType" class="form-select" required>
                                <option value="Running">Running</option>
                                <option value="Cycling">Cycling</option>
                                <option value="Walking">Walking</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Event Banner Image</label>
                        <input type="file" name="bannerFile" class="form-control" accept="image/*" />
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <button type="submit" class="btn btn-primary w-100 rounded-pill mt-4">Save Event</button>
                </form>
            </div>
        </div>
    </div>
</div>