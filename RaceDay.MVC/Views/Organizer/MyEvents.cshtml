@model List<RaceDay.Mvc.Controllers.EventDto>
@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">My Events</h2>
    <a asp-action="CreateEvent" class="btn btn-success rounded-pill px-4">+ Create Event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success rounded-pill">@TempData["Success"]</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">You haven't created any events yet.</div>
}
else
{
    <table class="table table-hover bg-white shadow-sm rounded">
        <thead class="table-light">
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Location</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td class="fw-bold">@ev.EventName</td>
                    <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@ev.Location</td>
                    <td>@ev.EventType</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary rounded-pill">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}