@{
    ViewData["Title"] = "Organizer Dashboard";
}

<h2 class="fw-bold mb-4">Organizer Dashboard</h2>

<div class="row">
    <div class="col-md-12">
        <div class="card shadow border-0 p-4 text-center">
            <h4 class="fw-bold">Welcome back, @Context.Session.GetString("UserName")!</h4>
            <p class="text-muted">Use the navigation bar above to manage your events and view enrollments.</p>
            <div class="mt-3">
                <a asp-action="MyEvents" class="btn btn-primary rounded-pill px-4">Manage My Events</a>
            </div>
        </div>
    </div>
</div>