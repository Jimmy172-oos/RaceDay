@model RaceDay.Mvc.Controllers.UserProfileDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-body p-5 text-center">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px; font-size: 36px;">
                    @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1) : "?")
                </div>
                <h3 class="fw-bold">@Model.FullName</h3>
                <p class="text-muted">@Model.Email</p>
                
                <hr class="my-4" />
                
                <div class="text-start">
                    <h5 class="fw-bold">Bio</h5>
                    <p class="text-muted">@(string.IsNullOrEmpty(Model.Profile?.Bio) ? "No bio added yet." : Model.Profile.Bio)</p>
                    
                    <h5 class="fw-bold mt-4">Date of Birth</h5>
                    <p class="text-muted">@(Model.Profile?.DateOfBirth?.ToString("dd MMM yyyy") ?? "Not provided")</p>
                </div>
                
                <button class="btn btn-primary rounded-pill px-5 mt-4">Save changes</button>
            </div>
        </div>
    </div>
</div>